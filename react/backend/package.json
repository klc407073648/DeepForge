{
  "name": "deepforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
