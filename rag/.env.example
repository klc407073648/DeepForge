# Copy to .env and fill in values.
#
# Common: one OpenAI-compatible provider for both (or use split keys below).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Optional: split embedding vs chat (e.g. OpenAI embeddings + DeepSeek chat).
# When EMBEDDING_BASE_URL / EMBEDDING_API_KEY are empty, OPENAI_* is used.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# CHAT_BASE_URL=
# CHAT_API_KEY=
#
# Embeddings: http = OpenAI-compatible POST /v1/embeddings (default)
#            local = process Hugging Face / local path model (install sentence-transformers)
# EMBEDDING_BACKEND=http
# EMBEDDING_MODEL=text-embedding-3-small
# For EMBEDDING_BACKEND=local, set a real model id, e.g.:
# EMBEDDING_BACKEND=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# (If LOCAL_EMBEDDING_MODEL is empty, EMBEDDING_MODEL is used as the model id.)
# LOCAL_EMBEDDING_DEVICE=
# LOCAL_EMBEDDING_BATCH_SIZE=32
#
# CHAT_MODEL=gpt-4o-mini
#
# CHROMA_PERSIST_DIR=data/chroma
# COLLECTION_NAME=rag_docs
# CHUNK_SIZE=512
# CHUNK_OVERLAP=128
# TOP_K=5
# MAX_CONTEXT_CHARS=8000
# MAX_RETRIEVAL_DISTANCE=1.25
# APP_NAME=rag-service
# APP_VERSION=0.1.0
#
# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO
# LOG_FILE=logs/rag-service.log
# Leave LOG_FILE empty for console-only logs.
